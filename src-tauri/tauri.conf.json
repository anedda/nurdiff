{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NurDiff",
  "version": "0.1.0",
  "identifier": "dev.nurdiff.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NurDiff",
        "width": 1280,
        "height": 760,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Valentino Anedda",
    "copyright": "Copyright © 2026 Valentino Anedda",
    "category": "DeveloperTool",
    "shortDescription": "Compare files and folders",
    "longDescription": "NurDiff compares two files or two folders side by side. It shows differences line by line and within lines, ignores minor differences such as line endings or whitespace, and works with Git as a difftool.",
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/64x64.png",
      "icons/32x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
